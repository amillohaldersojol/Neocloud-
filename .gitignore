# ===== NeoCloud NEO Avatar Engine =====

# Python virtual environments
avatar-engine/.venv/
avatar-engine/.sadtalker-venv/
avatar-engine/venv/

# Python cache
**/__pycache__/
*.pyc
*.pyo

# Generated avatar files
avatar-engine/input/
avatar-engine/temp/
avatar-engine/output/
avatar-engine/jobs/

# SadTalker generated/runtime files
avatar-engine/models/SadTalker/results/

